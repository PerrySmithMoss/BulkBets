# Non-secret VPS deployment configuration (shell-compatible).
# Frontend DNS -> Vercel; API DNS -> your existing Traefik VPS.
STACK_NAME=bulkbets
APP_HOST=bulkbets.your-domain.example
API_HOST=api.bulkbets.your-domain.example
BULKBETS_API_IMAGE=ghcr.io/perrysmithmoss/bulkbets-api:REPLACE_WITH_RELEASE_TAG
# Replace infra_postgres with the actual <infrastructure-stack>_postgres service.
DB_HOST=infra_postgres
POSTGRES_SERVICE=infra_postgres
DB_USER=bulkbets
DB_NAME=bulk_bets
DB_PORT=5432
DB_SSL_ENABLED=disable
# Comma-separated exact frontend origins; append a stable preview if needed.
CORS_ALLOWED_ORIGINS=https://${APP_HOST}
# Passwords/signing keys are external Docker secrets, never values in this file.
# Required: bulkbets_db_password, bulkbets_admin_password,
#           bulkbets_access_token_secret, bulkbets_refresh_token_secret.
# Resend SMTP (STARTTLS). Use a sender on a domain verified in Resend.
SMTP_ADDR=smtp.resend.com:587
SMTP_FROM=noreply@bulkbets.your-domain.example
# Put the Resend key in the bulkbets_smtp_password Swarm secret; use the SMTP overlay.
SMTP_USERNAME=resend
GOOGLE_CLIENT_ID=
