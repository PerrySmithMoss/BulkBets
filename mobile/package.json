{
  "name": "ironodds",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "build": "expo prebuild --clean",
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "export:native": "node scripts/validate-release.mts && expo export --platform ios --platform android --output-dir dist-native"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "^58.0.23",
    "expo-font": "~58.0.11",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint-plugin-expo": "^1.2.1",
    "expo-dev-client": "~58.0.18",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@expo/cli@58.1.19": {
      "glob": "14.0.4"
    },
    "@expo/fingerprint@0.21.9": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.5"
    }
  },
  "engines": {
    "node": "26.x"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
