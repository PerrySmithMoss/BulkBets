DB_ADDR=postgres://admin:adminpassword@localhost:55432/bulk_bets?sslmode=disable
DB_HOST=localhost
DB_PORT=55432
ADMIN_USER_PASSWORD=local-development-password
ACCESS_TOKEN_SECRET=local-access-secret-change-for-production
REFRESH_TOKEN_SECRET=local-refresh-secret-change-for-production
REFRESH_TOKEN_TTL=168h
# OAuth credentials are optional for local password login.

# Password recovery uses your SMTP provider; STARTTLS is required in production.
# SMTP_ADDR=smtp.resend.com:587
# SMTP_FROM=noreply@your-domain.example
# SMTP_USERNAME=
# SMTP_PASSWORD=
# APP_CLIENT_URL=http://localhost:3000
# Resend: SMTP_ADDR=smtp.resend.com:587, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<Resend API key>, SMTP_FROM=<address on your verified domain>.
# Local Docker Compose loads this file, then overrides it with server/.env if present.
# Containers override DB_ADDR, DB_HOST and DB_PORT to use the internal database.
