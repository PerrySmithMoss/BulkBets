# Go API origin for server-side requests and Next.js's same-origin /api proxy.
# Works with the Go API running locally or exposed from Docker on port 8080.
# Use the origin only: no trailing slash or /api path.
API_URL=http://127.0.0.1:8080

# This is the only app-specific environment variable currently used by the web app.
# Browser requests use relative /api URLs, so no NEXT_PUBLIC_* values are required.
# Restart the Next.js server after changing this file.
